@BankingReconciliation.Api_HostAddress = http://localhost:5230
@BranchFile = ./Samples/branch-transactions.csv
@BankFile = ./Samples/bank-transactions.csv

GET {{BankingReconciliation.Api_HostAddress}}/api/health
Accept: application/json

###

POST {{BankingReconciliation.Api_HostAddress}}/api/reconciliations/compare
Content-Type: multipart/form-data; boundary=ReconciliationBoundary

--ReconciliationBoundary
Content-Disposition: form-data; name="branchFile"; filename="branch-transactions.csv"
Content-Type: text/csv

< {{BranchFile}}
--ReconciliationBoundary
Content-Disposition: form-data; name="bankFile"; filename="bank-transactions.csv"
Content-Type: text/csv

< {{BankFile}}
--ReconciliationBoundary--
