{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowImmutableAuditArchive",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectRetention",
        "s3:PutObject",
        "s3:PutObjectRetention"
      ],
      "Resource": [
        "arn:aws:s3:::${BUCKET}/${PREFIX}/*"
      ]
    }
  ]
}
